# Database
DATABASE_URL="file:./dev.db"

# Session / Auth Secret (for local prototype demo only)
AUTH_SECRET="prototype-secret-key-kisii-tams-2026"

# Signed session token secret — must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Demo User Password (local prototype demo only)
DEMO_PASSWORD=ChangeMe-Demo-123

# Demo mode: set to true ONLY on your own computer for demos; ignored when NODE_ENV=production.
DEMO_MODE=false


# M7: distinct cryptographically random secret, at least 32 bytes. Never reuse SESSION_SECRET.
ATTENDANCE_TOKEN_SECRET=replace-with-a-distinct-random-32-byte-or-longer-secret
ATTENDANCE_WINDOW_KIND=AFTER_OPEN_UNTIL_END
ATTENDANCE_WINDOW_MINUTES=15
# Optional isolated synthetic QR simulation; disabled in production. Start/End class always use real time.
M7_SYNTHETIC_DEMO=false
M7_DEMO_OFFSET_MINUTES=0
# Enabling simulation also requires DEMO_MODE=true and DATABASE_URL=file:.../m7-demo-<name>.db
