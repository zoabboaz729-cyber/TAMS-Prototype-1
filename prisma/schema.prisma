// Prisma schema for Kisii University TAMS Prototype
// Prototype uses SQLite (spec §4). PostgreSQL switch is task M9-T1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Initial placeholder model for M0 foundation verification
// Full domain model is added in M1-T1 per spec §6
model SystemMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
